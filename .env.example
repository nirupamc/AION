# =============================================================================
# AION — Music Intelligence
# Copy to .env (which is gitignored) and fill in real values.
# NEVER commit a populated .env. NEVER commit Spotify client secrets or tokens.
# =============================================================================

# ---- General ----
ENV=development
LOG_LEVEL=INFO

# ---- Database ----
# SQLite for M0. Move to PostgreSQL in a later milestone.
DATABASE_URL=sqlite:///./data/aion.db

# ---- Web (Next.js) ----
# Public URL of the API, used by the web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Spotify OAuth ----
# Create an app at https://developer.spotify.com/dashboard
# Set Redirect URI to exactly:  http://localhost:8000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# Space-separated scopes. Start with the minimum required for M0.
# Reference: https://developer.spotify.com/documentation/web-api/concepts/scopes
SPOTIFY_SCOPES=user-read-private user-read-email playlist-read-private playlist-read-collaborative user-library-read playlist-modify-public playlist-modify-private

# Where to store OAuth state during the auth flow (in-memory store by default).
OAUTH_STATE_SECRET=change-me-to-a-long-random-string

# ---- MusicBrainz (read-only, anonymous, no API key) ----
# M2 uses MusicBrainz WSv2 to resolve ISRCs to Recording MBIDs.
# No key/OAuth required for reads, but a meaningful User-Agent is mandatory.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=AION/0.1 ( https://github.com/kilocode/aion )
# Minimum spacing between requests (seconds). MusicBrainz requests ~1 call/sec.
MUSICBRAINZ_MIN_INTERVAL=1.1

# ---- Soundcharts (commercial metadata, BPM/key) ----
# M4A spike. Requires a Soundcharts account + API client credentials.
# Get them at https://app.soundcharts.com (Console > Credentials)
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_BASE_URL=https://customer.api.soundcharts.com
SOUNDCHARTS_TOKEN_URL=https://account.soundcharts.com/oauth/token

# ---- GetSongBPM (free metadata, BPM/key) ----
# M4B PRIMARY enrichment source for BPM + musical key.
# Docs: https://getsongbpm.com/api
# Sign up at https://getsongbpm.com/api to receive an API key.
# Free tier: ~3000 requests/hour. Attribution/backlink to getsongbpm.com REQUIRED.
GETSONGBPM_API_KEY=
GETSONGBPM_BASE_URL=https://api.getsongbpm.com
# Minimum seconds between requests. 1.0s stays well under the 3000/hour limit.
GETSONGBPM_MIN_INTERVAL=1.0
GETSONGBPM_ANALYSIS_VERSION=m4b-getsongbpm-v1
GETSONGBPM_ATTRIBUTION_URL=https://getsongbpm.com
